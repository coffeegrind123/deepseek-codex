+/// A bounded external command used as one configurable status-line item.
+#[derive(Serialize, Deserialize, Debug, Clone, PartialEq, Eq, JsonSchema)]
+#[schemars(deny_unknown_fields)]
+pub struct TuiStatusLineCommand {
+    /// Argv for the command. Executed directly without shell interpolation.
+    #[schemars(length(min = 1))]
+    pub command: Vec<String>,
+
+    /// Minimum time between completed refreshes.
+    #[serde(default = "default_status_line_command_refresh_interval_ms")]
+    #[schemars(range(min = 1))]
+    pub refresh_interval_ms: u64,
+
+    /// Maximum runtime before the command is terminated.
+    #[serde(default = "default_status_line_command_timeout_ms")]
+    #[schemars(range(min = 1))]
+    pub timeout_ms: u64,
+
+    /// Text to show before the first successful refresh or after a failure.
+    #[serde(default)]
+    pub fallback: Option<String>,
+}
+
+const fn default_status_line_command_refresh_interval_ms() -> u64 {
+    60_000
+}
+
+const fn default_status_line_command_timeout_ms() -> u64 {
+    10_000
+}
+
 const fn default_true() -> bool {
     true
 }
