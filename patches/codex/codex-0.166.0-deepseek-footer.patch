+#[test]
+fn config_toml_deserializes_status_line_commands() {
+    let toml = r#"
+[tui]
+status_line = ["model-with-reasoning", "deepseek-balance"]
+
+[tui.status_line_commands.deepseek-balance]
+command = ["node", "/workspace/scripts/deepseek-balance.mjs", "status"]
+refresh_interval_ms = 90000
+timeout_ms = 2500
+fallback = "DeepSeek unavailable"
+"#;
+    let cfg: ConfigToml =
+        toml::from_str(toml).expect("TOML deserialization should succeed for status commands");
+    let tui = cfg.tui.expect("tui config should deserialize");
+
+    assert_eq!(
+        tui.status_line,
+        Some(vec![
+            "model-with-reasoning".to_string(),
+            "deepseek-balance".to_string(),
+        ])
+    );
+    assert_eq!(
+        tui.status_line_commands.get("deepseek-balance"),
+        Some(&codex_config::types::TuiStatusLineCommand {
+            command: vec![
+                "node".to_string(),
+                "/workspace/scripts/deepseek-balance.mjs".to_string(),
+                "status".to_string(),
+            ],
+            refresh_interval_ms: 90_000,
+            timeout_ms: 2_500,
+            fallback: Some("DeepSeek unavailable".to_string()),
+        })
+    );
+}
+
+#[test]
+fn status_line_command_defaults_refresh_and_timeout() {
+    let toml = r#"
+[tui.status_line_commands.balance]
+command = ["balance"]
+"#;
+    let cfg: ConfigToml =
+        toml::from_str(toml).expect("TOML deserialization should apply command defaults");
+    let command = cfg
+        .tui
+        .expect("tui config should deserialize")
+        .status_line_commands
+        .remove("balance")
+        .expect("balance command");
+
+    assert_eq!(command.refresh_interval_ms, 60_000);
+    assert_eq!(command.timeout_ms, 10_000);
+    assert_eq!(command.fallback, None);
+}
