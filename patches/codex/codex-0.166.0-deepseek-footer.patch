+#[tokio::test]
+async fn command_backed_status_line_uses_cached_output_and_fallback() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.local_settings.tui.status_line = Some(vec!["deepseek-balance".to_string()]);
+    chat.local_settings.tui.status_line_commands.insert(
+        "deepseek-balance".to_string(),
+        codex_config::types::TuiStatusLineCommand {
+            command: vec!["deepseek-balance".to_string(), "status".to_string()],
+            refresh_interval_ms: 60_000,
+            timeout_ms: 10_000,
+            fallback: Some("DeepSeek unavailable".to_string()),
+        },
+    );
+
+    chat.refresh_status_line();
+    assert_eq!(
+        status_line_text(&chat),
+        Some("DeepSeek unavailable".to_string())
+    );
+
+    let token = *chat
+        .status_line_command_tokens
+        .get("deepseek-balance")
+        .expect("status command token");
+    chat.set_status_line_command_output(
+        token,
+        "deepseek-balance".to_string(),
+        Some("DeepSeek $18.75 USD".to_string()),
+    );
+    chat.refresh_status_line();
+    assert_eq!(
+        status_line_text(&chat),
+        Some("DeepSeek $18.75 USD".to_string())
+    );
+
+    assert!(!chat.set_status_line_command_output(
+        token.wrapping_add(1),
+        "deepseek-balance".to_string(),
+        None,
+    ));
+    assert!(chat.set_status_line_command_output(token, "deepseek-balance".to_string(), None,));
+    assert!(chat.set_status_line_command_output(token, "deepseek-balance".to_string(), None,));
+    chat.refresh_status_line();
+    assert_eq!(
+        status_line_text(&chat),
+        Some("DeepSeek $18.75 USD (stale)".to_string())
+    );
+}
