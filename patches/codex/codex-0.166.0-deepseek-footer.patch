+use std::path::Path;
+use std::process::Stdio;
+use std::time::Duration;
+
+use tokio::io::AsyncReadExt;
+use tokio::process::Command;
+use tokio::time::Instant;
+
+const MAX_STATUS_LINE_COMMAND_BYTES: usize = 4 * 1024;
+const MAX_STATUS_LINE_COMMAND_CHARS: usize = 240;
+
+/// Runs one configured status-line command and returns a compact, single-line value.
+pub(crate) async fn run(argv: &[String], cwd: &Path, timeout: Duration) -> Option<String> {
+    let (program, args) = argv.split_first()?;
+    if program.is_empty() {
+        return None;
+    }
+
+    let mut command = Command::new(program);
+    command
+        .args(args)
+        .current_dir(cwd)
+        .stdin(Stdio::null())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true);
+    #[cfg(unix)]
+    command.process_group(/*pgroup*/ 0);
+
+    let mut child = command.spawn().ok()?;
+    let child_pid = child.id();
+    let Some(mut stdout) = child.stdout.take() else {
+        terminate(&mut child, child_pid).await;
+        return None;
+    };
+
+    let deadline = Instant::now() + timeout;
+    let mut output = Vec::with_capacity(MAX_STATUS_LINE_COMMAND_BYTES);
+    let mut chunk = [0_u8; 1024];
+    loop {
+        if output.len() >= MAX_STATUS_LINE_COMMAND_BYTES {
+            terminate(&mut child, child_pid).await;
+            return None;
+        }
+        let read = match tokio::time::timeout_at(deadline, stdout.read(&mut chunk)).await {
+            Ok(Ok(read)) => read,
+            Ok(Err(_)) | Err(_) => {
+                terminate(&mut child, child_pid).await;
+                return None;
+            }
+        };
+        if read == 0 {
+            break;
+        }
+        let remaining = MAX_STATUS_LINE_COMMAND_BYTES - output.len();
+        if read > remaining {
+            terminate(&mut child, child_pid).await;
+            return None;
+        }
+        output.extend_from_slice(&chunk[..read]);
+    }
+    drop(stdout);
+
+    let status = match tokio::time::timeout_at(deadline, child.wait()).await {
+        Ok(Ok(status)) => status,
+        Ok(Err(_)) | Err(_) => {
+            terminate(&mut child, child_pid).await;
+            return None;
+        }
+    };
+    if !status.success() {
+        terminate_process_group(child_pid);
+        return None;
+    }
+    terminate_process_group(child_pid);
+
+    sanitize(&String::from_utf8_lossy(&output))
+}
+
+async fn terminate(child: &mut tokio::process::Child, child_pid: Option<u32>) {
+    terminate_process_group(child_pid);
+    let _ = child.start_kill();
+    let _ = child.wait().await;
+}
+
+fn terminate_process_group(child_pid: Option<u32>) {
+    #[cfg(unix)]
+    if let Some(pid) = child_pid {
+        // SAFETY: process_group(0) assigned the child its own group. The group ID remains
+        // reserved while any descendant is still a member.
+        unsafe { libc::killpg(pid as libc::pid_t, libc::SIGKILL) };
+    }
+    #[cfg(not(unix))]
+    let _ = child_pid;
+}
+
+/// Converts command output into one control-free display segment.
+pub(crate) fn sanitize(raw: &str) -> Option<String> {
+    let first_line = raw.lines().find(|line| !line.trim().is_empty())?;
+    let plain = strip_ansi(first_line);
+    let normalized = plain
+        .chars()
+        .filter(|character| {
+            !character.is_control()
+                && !matches!(
+                    character,
+                    '\u{200b}'..='\u{200f}'
+                        | '\u{202a}'..='\u{202e}'
+                        | '\u{2066}'..='\u{2069}'
+                        | '\u{feff}'
+                )
+        })
+        .collect::<String>()
+        .split_whitespace()
+        .collect::<Vec<_>>()
+        .join(" ");
+    if normalized.is_empty() {
+        return None;
+    }
+
+    let mut text = normalized
+        .chars()
+        .take(MAX_STATUS_LINE_COMMAND_CHARS)
+        .collect::<String>();
+    if normalized.chars().count() > MAX_STATUS_LINE_COMMAND_CHARS {
+        text.pop();
+        text.push('…');
+    }
+    Some(text)
+}
+
+fn strip_ansi(raw: &str) -> String {
+    let mut output = String::with_capacity(raw.len());
+    let mut chars = raw.chars().peekable();
+    while let Some(character) = chars.next() {
+        if character == '\u{1b}' {
+            match chars.peek().copied() {
+                Some('[') => {
+                    chars.next();
+                    consume_csi(&mut chars);
+                }
+                Some(']') => {
+                    chars.next();
+                    consume_osc(&mut chars);
+                }
+                Some(_) => {
+                    chars.next();
+                }
+                None => {}
+            }
+            continue;
+        }
+        if character == '\u{009b}' {
+            consume_csi(&mut chars);
+            continue;
+        }
+        output.push(character);
+    }
+    output
+}
+
+fn consume_csi(chars: &mut std::iter::Peekable<std::str::Chars<'_>>) {
+    for character in chars.by_ref() {
+        if ('@'..='~').contains(&character) {
+            break;
+        }
+    }
+}
+
+fn consume_osc(chars: &mut std::iter::Peekable<std::str::Chars<'_>>) {
+    let mut previous = '\0';
+    for character in chars.by_ref() {
+        if character == '\u{0007}' || (previous == '\u{1b}' && character == '\\') {
+            break;
+        }
+        previous = character;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn sanitizes_ansi_and_uses_first_nonempty_line() {
+        assert_eq!(
+            sanitize("\u{1b}[32mDeepSeek\u{1b}[0m\n$18.75\tUSD\nsecret"),
+            Some("DeepSeek".to_string())
+        );
+    }
+
+    #[test]
+    fn strips_osc_sequences_without_panicking() {
+        assert_eq!(
+            sanitize("\u{1b}]0;title\u{0007}DeepSeek $18.75"),
+            Some("DeepSeek $18.75".to_string())
+        );
+        assert_eq!(sanitize("DeepSeek\u{1b}[31"), Some("DeepSeek".to_string()));
+    }
+
+    #[test]
+    fn removes_bidi_and_other_control_characters() {
+        assert_eq!(
+            sanitize("DeepSeek\u{202e} \u{0007}$18.75\u{feff}"),
+            Some("DeepSeek $18.75".to_string())
+        );
+    }
+
+    #[test]
+    fn rejects_blank_output() {
+        assert_eq!(sanitize(" \n\t\n"), None);
+    }
+
+    #[test]
+    fn caps_oversized_output() {
+        let output = sanitize(&"x".repeat(300)).expect("non-empty output");
+        assert_eq!(output.chars().count(), MAX_STATUS_LINE_COMMAND_CHARS);
+        assert!(output.ends_with('…'));
+    }
+
+    #[tokio::test]
+    async fn runs_argv_and_returns_sanitized_stdout() {
+        let argv = vec![
+            "sh".to_string(),
+            "-c".to_string(),
+            "printf '\\033[32mDeepSeek\\033[0m\\n$18.75 USD\\n'".to_string(),
+        ];
+        assert_eq!(
+            run(&argv, &std::env::temp_dir(), Duration::from_secs(1)).await,
+            Some("DeepSeek".to_string())
+        );
+    }
+
+    #[tokio::test]
+    async fn rejects_oversized_output_without_waiting_for_the_process() {
+        let argv = vec![
+            "sh".to_string(),
+            "-c".to_string(),
+            "yes x | head -c 8192; sleep 5".to_string(),
+        ];
+        let started = Instant::now();
+        assert_eq!(
+            run(&argv, &std::env::temp_dir(), Duration::from_secs(10)).await,
+            None
+        );
+        assert!(started.elapsed() < Duration::from_secs(2));
+    }
+
+    #[tokio::test]
+    async fn ignores_nonzero_exit_and_timed_out_commands() {
+        let nonzero = vec!["sh".to_string(), "-c".to_string(), "exit 7".to_string()];
+        assert_eq!(
+            run(&nonzero, &std::env::temp_dir(), Duration::from_secs(1)).await,
+            None
+        );
+
+        let slow = vec!["sh".to_string(), "-c".to_string(), "sleep 2".to_string()];
+        assert_eq!(
+            run(&slow, &std::env::temp_dir(), Duration::from_millis(10)).await,
+            None
+        );
+    }
+}
