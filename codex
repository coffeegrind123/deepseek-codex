#!/usr/bin/env bash
# Run the folder-local Codex CLI: CODEX_HOME is this folder, cwd is the caller's folder, the
# model router is started outside the cage, then codex and everything it spawns run under a
# Landlock policy that can write only here, the work folder and .codex/cage.conf roots. All
# args pass to codex.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CAGE="$ROOT/sandbox/landlock-exec.py"

# Project-local update path: ./codex update
if [[ "${1:-}" == "update" ]]; then
  shift
  exec "$ROOT/codex-update" "$@"
fi

if [[ "${1:-}" == "balance" ]]; then
  shift
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.codex/secrets.env"
  set +a
  exec node "$ROOT/scripts/deepseek-balance.mjs" show "$@"
fi

# ./codex ovis start|stop|status|token|run|gate|install: the web and phone client
# (README "Ovis"). Runs outside the cage, before the secrets are loaded.
if [[ "${1:-}" == "ovis" ]]; then
  shift
  exec "$ROOT/scripts/ovis.sh" "$@"
fi

# ./codex team-solve [args]: the team-solve skill's runner (.codex/skills/team-solve) instead
# of the Codex TUI, with the same router, secrets and cage. --dir DIR is its work folder.
TEAM_SOLVE=0
if [[ "${1:-}" == "team-solve" ]]; then
  TEAM_SOLVE=1
  shift
fi

BIN="$("$ROOT/scripts/resolve-codex-bin.sh")"
[[ -x "$BIN" ]] || { printf 'codex: %s missing; run: npm install\n' "$BIN" >&2; exit 1; }

"$ROOT/codex-router" ensure >/dev/null

# Run an optional integration maintained outside this repository. The hook is an
# explicit opt-in and failures must not prevent Codex from starting.
if [[ -n "${CODEX_START_HOOK:-}" && -x "$CODEX_START_HOOK" ]]; then
  "$CODEX_START_HOOK" ensure >/dev/null 2>&1 || true
fi

# Keep Ovis up (README "Ovis"): interactive launches only, so `exec` runs and other
# unattended launches never start it. Not from inside the cage (herdr
# would cage every pane) or a herdr pane (it is up). Detached and before the
# secrets are loaded, so the TUI never waits and herdr's panes never inherit
# them. ovis.sh reads OVIS_ENABLED itself.
if [[ -t 0 && -t 1 && -z "${CODEX_LANDLOCK_CAGE:-}" && "${HERDR_ENV:-}" != 1 ]]; then
  setsid "$ROOT/scripts/ovis.sh" start --quiet </dev/null >/dev/null 2>&1 &
fi

set -a
# shellcheck disable=SC1091
. "$ROOT/.codex/secrets.env"
set +a

CAGE_RW=()
CAGE_NET="${CODEX_NET:-open}"
# shellcheck disable=SC1091
[[ -f "$ROOT/.codex/cage.conf" ]] && . "$ROOT/.codex/cage.conf"

cage_args=(--rw "$ROOT")

# Work in the caller's folder (or the last -C/--cd DIR) and make it writable in the cage.
# Run from / or $HOME, it falls back to this folder so the cage never opens up all of home.
work="$PWD"
prev=""
for arg in "$@"; do
  case "$prev" in
    -C|--cd) work="$arg" ;;
    --dir) if (( TEAM_SOLVE )); then work="$arg"; fi ;;
  esac
  case "$arg" in
    --cd=*) work="${arg#--cd=}" ;;
    --dir=*) if (( TEAM_SOLVE )); then work="${arg#--dir=}"; fi ;;
  esac
  prev="$arg"
done
work="$(realpath -e -- "$work")" || { printf 'codex: no such folder: %s\n' "$work" >&2; exit 1; }
if [[ "$work" == "/" || "$work" == "$(realpath "$HOME")" ]]; then
  work="$ROOT"
fi
[[ "$work" == "$ROOT" || "$work" == "$ROOT"/* ]] || cage_args+=(--rw "$work")

for dir in "${CAGE_RW[@]}"; do
  [[ -d "$dir" ]] && cage_args+=(--rw "$dir")
done
if [[ "$CAGE_NET" == "restricted" ]]; then
  cage_args+=(--net restricted --tcp-connect "${CODEX_ROUTER_PORT:-8877}")
else
  cage_args+=(--net open)
fi

export CODEX_HOME="$ROOT/.codex"
export TMPDIR="${TMPDIR:-/tmp}"
export CODEX_MANAGED_PACKAGE_ROOT="$ROOT/node_modules/@openai/codex"
export CODEX_MANAGED_BY_NPM=1
export DEEPSEEK_BALANCE_CACHE_FILE="$ROOT/.codex/cache/deepseek-balance.json"
# Without scripts/ovis-shims, which a herdr pane puts first: a `codex` that Codex
# itself runs must not go through ./codex and the cage a second time.
PATH=":$PATH:"
while [[ "$PATH" == *":$ROOT/scripts/ovis-shims:"* ]]; do
  PATH="${PATH//":$ROOT/scripts/ovis-shims:"/:}"
done
PATH="${PATH#:}"
export PATH="$ROOT/scripts:${PATH%:}"

# Keep the footer cache fresh outside the Landlock cage. The same daemon also
# owns the window/tab title unless that fallback is explicitly disabled.
# In a herdr pane the title stays the shell's: herdr and Ovis name a pane after its
# terminal title, so every Codex pane was called "DeepSeek $21.45 USD". The daemon
# still runs there with --no-title, or the footer's balance would go stale.
balance_title="${CODEX_DEEPSEEK_BALANCE_TITLE:-auto}"
balance_args=(
  title
  --parent-pid "$$"
  --tty-fd 1
  --project "$work"
  --cache-file "$DEEPSEEK_BALANCE_CACHE_FILE"
)
if [[ "$balance_title" == "off" || "${HERDR_ENV:-}" == 1 ]]; then
  balance_args+=(--no-title)
fi
if [[ -t 1 ]]; then
  node "$ROOT/scripts/deepseek-balance.mjs" "${balance_args[@]}" \
    </dev/null >&1 2>/dev/null &
fi

# End-result verifier hooks (.codex/config.toml -> .codex/hooks/verify.py) are enabled by
# passing --dangerously-bypass-hook-trust: config hooks otherwise run only after being
# trusted interactively via /hooks, which non-interactive `./codex exec` can't do. The
# flag's own help says it is "intended only for automation that already vets hook sources"
# — that is this case: the hooks are version-controlled in this workspace, authored here,
# and .codex/AGENTS.md forbids the agent editing config from untrusted content. It applies
# ONLY to hooks; it changes nothing about the Landlock cage or command approvals.
# Opt out (e.g. to rely on persisted /hooks trust in a TUI session) with CODEX_HOOK_TRUST=strict.
hook_args=()
if [[ "${CODEX_HOOK_TRUST:-bypass}" != "strict" ]]; then
  hook_args+=(--dangerously-bypass-hook-trust)
fi

cd "$work"
if (( TEAM_SOLVE )); then
  # The agents mode spawns this same Codex binary for each role. --dir is re-passed as the
  # resolved absolute folder (argparse keeps the last one): a relative --dir would now
  # resolve against the folder we just cd'd into.
  export CODEX_WORKSPACE_BIN="$BIN"
  ts_args=("$@")
  case "${1:-}" in run|check|status) ts_args+=(--dir "$work") ;; esac
  exec python3 "$CAGE" "${cage_args[@]}" -- \
    python3 "$ROOT/.codex/skills/team-solve/scripts/team_solve.py" "${ts_args[@]}"
fi
exec python3 "$CAGE" "${cage_args[@]}" -- "$BIN" "${hook_args[@]}" "$@"
