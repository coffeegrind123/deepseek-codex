DEEPSEEK_API_KEY=sk-...
# Optional: only needed to pick glm-5.3 with /model.
ZAI_API_KEY=<z.ai GLM Coding Plan key, format: 32hex.16chars>
CODEX_ROUTER_TOKEN=<any random string; run: head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'>
CODEX_ROUTER_PORT=8877
# Optional: Ovis (README "Ovis"). Unset, a token is generated into .codex/ovis/token.
# OVIS_TOKEN=<a long random string>   or   OVIS_TOKEN=off (no sign-in; read README first)
# OVIS_ENABLED=0       # do not start Ovis
# OVIS_PORT=7327       # the Docker host's 127.0.0.1 port the gate publishes
# OVIS_CODEX_PANE=0    # new herdr panes are plain shells instead of Codex
